# ===================================================================
# CSC337 Lab Assignment 06: Multi-Tenant Kafka SaaS Platform
# Environment Configuration Template
# ===================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=production

# Database Connection Pooling (PostgreSQL / Neon / Supabase / Vercel Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=saas_db
PG_POOL_MAX=10
PG_POOL_MIN=2

# Apache Kafka Configuration (Upstash / Aiven / Local Broker)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=saas-order-service
KAFKA_GROUP_ID=orders-consumer-group
KAFKA_TOPIC=tenant.orders

# Upstash Kafka (Serverless Cloud Kafka SASL / REST credentials)
# Optional: If left blank, automatically runs high-performance virtual Kafka bus
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_TOKEN=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL=true

# Serverless Cold-Start Simulation Latency (ms)
COLD_START_DELAY_MS=580
WARM_START_DELAY_MS=35
